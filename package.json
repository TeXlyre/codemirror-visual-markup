{
  "name": "codemirror-visual-markup",
  "version": "0.2.0",
  "description": "Visual editing for LaTeX and Typst in CodeMirror 6",
  "author": "Fares Abawi <fares@abawi.me>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeXlyre/codemirror-visual-markup.git"
  },
  "scripts": {
    "build": "tsc --noEmit && rollup -c && cp src/styles.css dist/",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepare": "npm run build",
    "build:pages-example": "cd example/github-pages-example && npm install",
    "pages-example": "cd example/github-pages-example && npm start"
  },
  "dependencies": {
    "tex2typst": "^0.6.2"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "mathlive": ">=0.106.0"
  },
  "peerDependenciesMeta": {
    "mathlive": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mathlive": "^0.107.0",
    "rollup": "^3.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "ts-jest": "^29.1.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "keywords": [
    "codemirror",
    "latex",
    "typst",
    "visual-editor",
    "wysiwym",
    "mathlive"
  ]
}
